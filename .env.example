OPENAI_API_KEY=
OPENAI_MODEL=
DEMO_MODE=false
# Modules supplied by Person A and Person B; see docs/CONTRACTS.md
DATA_MODULE=
ML_MODULE=
MODEL_PATH=models/production
TURBINES_FILE=config/turbines.json
WEATHER_CACHE_DIR=data/cache

# Strict target T1/T2 path; see docs/TARGET_FORECAST_CONTRACT.md.
# Integrated A/B providers. Source protocol, weather availability and model gates still apply.
FORECAST_DATA_MODULE=src.data.weather
FORECAST_ML_MODULE=src.ml.goldwind_provider
FORECAST_MODEL_PATH=models/goldwind/power_model.joblib
FORECAST_MANIFEST_PATH=models/goldwind/forecast_manifest.json
FORECAST_PROTOCOL_PATH=config/forecast_protocol.json
FORECAST_CACHE_DIR=data/cache/forecast_v2
FORECAST_RESULTS_DIR=results/forecast_v2

# Single Runs adapter; see docs/DATA_WEATHER.md. No API key needed.
ARCHIVAL_WEATHER_CACHE_DIR=data/weather_cache
WEATHER_WIND_HEIGHT_M=80
WEATHER_AVAILABILITY_PATH=config/weather_availability.template.json
